# ==============================================================================
# KART BRAWL - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# The .env file is gitignored and will never be committed to source control.

# Server Port & Binding
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Allowed CORS Origins (Comma-separated for multiple origins, or * for all)
# Production example: https://kartbrawl.netlify.app,https://your-custom-domain.com
CORS_ORIGIN=*

# ==============================================================================
# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
# ==============================================================================
# 1. Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Browser-safe Publishable Key (current format: sb_publishable_... or legacy anon public key)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# SECURITY DIRECTIVE:
# NEVER expose SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY to client/browser code.
# Only publishable/anon keys are permitted in client/frontend contexts.
